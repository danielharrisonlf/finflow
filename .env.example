# Banco de dados
# Por padrão o FinFlow usa SQLite embutido (zero Docker).
# Caminho relativo definido aqui é resolvido a partir da pasta deste .env.
# Sem FINFLOW_DB_PATH, o banco fica em <UserConfigDir>/finflow/finflow.db.
FINFLOW_DB_PATH=finflow.db

# Fuso usado para "hoje" e mês corrente (padrão America/Sao_Paulo)
# FINFLOW_TZ=America/Sao_Paulo

# Opcional: para usar PostgreSQL em vez de SQLite, descomente abaixo (docker compose --profile postgres up -d db)
# DATABASE_URL="postgresql://finflow:finflow@localhost:5435/finflow?schema=public"

# Servidor HTTP (API + Web embutido)
API_PORT=3333
# Celular na mesma rede: escuta em todas as interfaces (exige FINFLOW_PASSWORD). Sem isso, só 127.0.0.1.
# FINFLOW_LAN=1

# Assistente (opcional). Sem nada aqui, um Ollama em FINFLOW_OLLAMA_URL é detectado sozinho e tudo pode
# ser escolhido em Configurações > Assistente. Definir FINFLOW_AI_PROVIDER trava o provedor.
# FINFLOW_OLLAMA_URL=http://localhost:11434
# FINFLOW_AI_PROVIDER=ollama            # ollama | openai_compatible | claude
# FINFLOW_AI_BASE_URL=http://localhost:11434   # LM Studio: http://localhost:1234/v1
# FINFLOW_AI_MODEL=qwen2.5:7b           # modelo com suporte a ferramentas
# FINFLOW_AI_VISION_MODEL=qwen2.5vl:7b  # opcional, para ler comprovantes
# FINFLOW_AI_API_KEY=                   # servidor compatível que exige chave
# ANTHROPIC_API_KEY=                    # provedor claude

# Origem extra aceita pelo CORS (dev server do Vite)
WEB_ORIGIN=http://localhost:5273

# Autenticação (opcional em uso local; obrigatória antes de expor na rede)
# Quando FINFLOW_PASSWORD está definida, todas as rotas exigem login (Bearer token).
FINFLOW_PASSWORD=
FINFLOW_AUTH_SECRET=
FINFLOW_API_TOKEN=

# Telegram Bot (opcional — sem token o módulo fica inativo, nada quebra)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# CLI / MCP apontando para uma API remota (se omitido, acessam o banco local diretamente)
# FINFLOW_API_URL=http://localhost:3333
# FINFLOW_TOKEN=

# Frontend (opcional — em dev usa http://localhost:3333; em produção embutida usa same-origin /api)
# VITE_API_URL=http://localhost:3333

# Testes: roda a suíte também em PostgreSQL (docker compose --profile test up -d db_test)
# FINFLOW_TEST_DATABASE_URL="postgres://finflow:finflow@localhost:5434/finflow_test?sslmode=disable"

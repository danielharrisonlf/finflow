# PostgreSQL (docker compose up -d db)
DATABASE_URL="postgresql://finflow:finflow@localhost:5435/finflow?schema=public"

# Banco exclusivo de testes de integração (docker compose up -d db_test).
# O nome do banco DEVE terminar em _test.
DATABASE_URL_TEST="postgresql://finflow:finflow@localhost:5434/finflow_test?schema=public"

# API
API_PORT=3333
WEB_ORIGIN=http://localhost:5273

# Autenticação (opcional em dev local; obrigatória antes de expor a API publicamente)
# Quando FINFLOW_PASSWORD está definida, todas as rotas exigem login (Bearer token).
FINFLOW_PASSWORD=
FINFLOW_AUTH_SECRET=
FINFLOW_API_TOKEN=

# Telegram Bot (opcional — sem token o módulo fica inativo, nada quebra)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Frontend
VITE_API_URL=http://localhost:3333

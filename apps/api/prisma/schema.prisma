generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  SALARY
  INVESTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  CARD_EXPENSE
  INVOICE_PAYMENT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

model Account {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String
  type                AccountType
  initialBalanceCents Int         @default(0) @map("initial_balance_cents")
  color               String?
  archived            Boolean     @default(false)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("accounts")
}

model Category {
  id       String       @id @default(uuid()) @db.Uuid
  name     String
  kind     CategoryKind
  icon     String
  color    String
  parentId String?      @map("parent_id") @db.Uuid

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budget       Budget?

  @@unique([name, kind])
  @@map("categories")
}

model CreditCard {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  brand      CardBrand
  limitCents Int       @map("limit_cents")
  closingDay Int       @map("closing_day")
  dueDay     Int       @map("due_day")
  color      String?
  archived   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  invoices     Invoice[]
  transactions Transaction[]

  @@map("credit_cards")
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  cardId               String        @map("card_id") @db.Uuid
  month                Int
  year                 Int
  status               InvoiceStatus @default(OPEN)
  paidAt               DateTime?     @map("paid_at")
  paymentTransactionId String?       @unique @map("payment_transaction_id") @db.Uuid

  card               CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  paymentTransaction Transaction?  @relation("InvoicePayment", fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  transactions       Transaction[] @relation("InvoiceItems")

  @@unique([cardId, year, month])
  @@map("invoices")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  type        TransactionType
  description String
  /// Assinado: receitas > 0, despesas < 0. Pernas de transferência têm sinais opostos.
  amountCents Int               @map("amount_cents")
  date        DateTime          @db.Date
  status      TransactionStatus @default(CONFIRMED)

  accountId          String? @map("account_id") @db.Uuid
  cardId             String? @map("card_id") @db.Uuid
  categoryId         String? @map("category_id") @db.Uuid
  invoiceId          String? @map("invoice_id") @db.Uuid
  transferGroupId    String? @map("transfer_group_id") @db.Uuid
  installmentGroupId String? @map("installment_group_id") @db.Uuid
  installmentNumber  Int?    @map("installment_number")
  installmentTotal   Int?    @map("installment_total")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account        Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card           CreditCard? @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoice        Invoice?    @relation("InvoiceItems", fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentFor     Invoice?    @relation("InvoicePayment")

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
  @@index([invoiceId])
  @@index([type, status])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @unique @map("category_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Goal {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  icon        String    @default("piggy-bank")
  color       String?
  targetCents Int       @map("target_cents")
  deadline    DateTime? @db.Date
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id          String   @id @default(uuid()) @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  /// Positivo = aporte, negativo = resgate.
  amountCents Int      @map("amount_cents")
  date        DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

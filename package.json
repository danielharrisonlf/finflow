{
  "name": "finflow",
  "private": true,
  "version": "0.1.0",
  "description": "FinFlow — controle financeiro pessoal (Go binário único + React web)",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "go run ./cmd/finflow serve",
    "dev:web": "pnpm --filter @finflow/web dev",
    "build:web": "pnpm --filter @finflow/contracts build && pnpm --filter @finflow/web build && node scripts/sync-webui.mjs",
    "build:go": "node scripts/build-go.mjs",
    "build": "pnpm build:web && pnpm build:go",
    "serve": "go run ./cmd/finflow serve",
    "seed": "go run ./cmd/finflow seed",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "go test -v ./...",
    "test:e2e": "pnpm --filter @finflow/contracts build && pnpm --filter @finflow/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "turbo": "2.8.20",
    "typescript": "6.0.3"
  }
}

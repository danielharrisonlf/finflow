# dependencies
node_modules/

# builds & binaries
dist/
build/
# build do app no navegador (pnpm build:browser → pacote público em /app/)
apps/web/dist-browser/
# runtime do navegador gerado por `pnpm build:wasm` (finflow.wasm, wasm_exec.js, runtime.json)
apps/web/public/runtime/
.turbo/
*.tsbuildinfo
# binário na raiz (ancorado para não ignorar cmd/finflow/)
/finflow
/finflow.exe
# web embutido: só o placeholder é versionado (go:embed exige ao menos um arquivo)
!internal/webui/dist/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# local SQLite databases
*.db
*.db-wal
*.db-shm

# environment — nunca versionar credenciais
.env
.env.*
!.env.example

# tests
coverage/
playwright-report/
test-results/
blob-report/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# configuração local do Claude Code (as skills do projeto em .claude/skills são versionadas)
.claude/settings.local.json
